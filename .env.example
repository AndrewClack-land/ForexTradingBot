# Telegram
TELEGRAM_TOKEN=CHANGE_ME
TELEGRAM_CHANNEL_ID=CHANGE_ME
# Comma-separated user/chat ids allowed to run /status /open /report /universe
TELEGRAM_ADMIN_IDS=

# MT5
MT5_LOGIN=CHANGE_ME
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=FxPro-MT5 Demo

# tvDatafeed
TV_LOGIN_MODE=nologin
TV_USERNAME=
TV_PASSWORD=

# flags
POST_STARTUP_REPORT=0
REPORT_DEFAULT_LIMIT=15
LOG_TICK=0
# Broker split-leg lifecycle / break-even polling (clamped to 1..5 seconds)
MANAGEMENT_POLL_SEC=3

# AI outcome calibration. Aggregate symbol stats remain diagnostic; entry
# rejection trusts only the independent-idea bucket symbol x primary trigger.
# Until this bucket reaches the threshold, the gate fails open.
AI_MIN_CLOSED_TRIGGER=30
# Legacy binary TP/SL trigger buckets are diagnostic-only until replaced by
# idempotent idea-level realized-net-R calibration.
AI_TRIGGER_CALIBRATION_ENABLED=0

# Native exact-retest LIMIT lifecycle. Disabled until canary deployment.
# A fully filtered setup arms a broker LIMIT only while price is still on the
# approach side of the entry zone; server-side expiry is mandatory.
PERSISTENT_LIMIT_ENABLED=0
PERSISTENT_LIMIT_SYMBOLS=EURUSD
PERSISTENT_LIMIT_TTL_MIN=15
# Emergency-only: close a newly filled conflicting LIMIT position only after
# exact plan id/comment/symbol/magic ownership is revalidated. Default OFF.
PERSISTENT_LIMIT_CONFLICT_AUTOCLOSE_ENABLED=0

# Strictly diagnostic, read-only tick recovery. It records causal tick touches
# and the quote visible to each 60-second scan; it cannot access order methods.
SHADOW_TICK_WATCHER_ENABLED=0
SHADOW_TICK_WATCHER_POLL_SEC=5
SHADOW_TICK_WATCHER_MAX_BACKFILL_SEC=3600

# Shadow-only simultaneous trigger ledger. The production waterfall remains
# authoritative; this records scan observations and de-duplicated daily ideas.
SHADOW_CANDIDATE_LEDGER_ENABLED=0
# Optional versioned JSON inputs. Both are required before the ledger attaches
# expected-net and portfolio-correlation scores; missing inputs never gate live.
SHADOW_CANDIDATE_COST_PROFILE_PATH=
SHADOW_CANDIDATE_CORRELATION_PROFILE_PATH=

# Compensating entry filters. Default OFF. Enabling requires a measured
# execution-quality profile; a profile with news_filter_enabled also requires
# a point-in-time revision calendar (a current final calendar is not valid for
# historical evaluation).
EXECUTION_QUALITY_FILTER_ENABLED=0
EXECUTION_QUALITY_PROFILE_PATH=
NEWS_CALENDAR_PATH=

# FVG regime stays time-unbounded in production. Event invalidation remains an
# explicit research variant until paired OOS evidence supports it.
FVG_REGIME_MAX_AGE_BARS=0
FVG_EVENT_INVALIDATION_MODE=none

# Immutable setup-level telemetry tags (set a new deployment id for every VPS release)
STRATEGY_VERSION=narrative-1r2r3r-rbh1-v1
STRATEGY_EXPERIMENT_ID=rb-h1-live-20260804
STRATEGY_EXPERIMENT_VARIANT=rb-h1-enabled
DEPLOYMENT_ID=CHANGE_ME

# RB M15 is retired and the legacy flag is ignored/hard-false in code.
REJECTION_BLOCK_ENTRY_ENABLED=0
# RB H1 is the primary rejection-block entry trigger. Set 0 for emergency rollback.
REJECTION_BLOCK_H1_ENTRY_ENABLED=1

# FxPro OTC depth recorder. It records broker quotes, not executed-aggressor
# flow; quote removal must never be interpreted as a fill.
FXPRO_DOM_CAPTURE_ENABLED=0
FXPRO_DOM_SYMBOLS=EURUSD,GBPUSD,USDCAD
FXPRO_DOM_DATA_DIR=
FXPRO_DOM_POLL_MS=500
FXPRO_DOM_MAX_LEVELS=20
FXPRO_DOM_HEARTBEAT_SEC=1.0

# Broker-specific Quote Pressure Rejection replacement for Turtle Soup.
# Keep entries disabled while DOM history is accumulated and validated by WFO.
FXPRO_QUOTE_PRESSURE_REJECTION_ENTRY_ENABLED=0
FXPRO_LIQUIDITY_MIN_ABS_QUOTE_PRESSURE=0.15
FXPRO_LIQUIDITY_MIN_REPLENISHMENT_RATIO=0.50
FXPRO_LIQUIDITY_MIN_REPLENISHMENT_SHARE=0.55
FXPRO_LIQUIDITY_MIN_REJECTION_FRACTION=0.60
FXPRO_LIQUIDITY_MAX_PRICE_RESPONSE_EFFICIENCY=0.35
FXPRO_LIQUIDITY_MIN_COVERAGE_RATIO=0.98
FXPRO_LIQUIDITY_MAX_GAP_SECONDS=5.0
FXPRO_LIQUIDITY_MIN_CHANGED_SNAPSHOTS=20
FXPRO_LIQUIDITY_MIN_BOOK_LEVELS=2
FXPRO_LIQUIDITY_MAX_MEAN_SPREAD_BPS=5.0

# Optional demo experiments (off unless explicitly enabled)
DAILY_FLAT_ENABLED=0
DAILY_CLOSE_HOUR=21
# Stop accepting entries this many minutes before the daily close
DAILY_CLOSE_BUFFER_MIN=30
# Same-direction positive-correlation groups, e.g. EURUSD+GBPUSD
CORRELATED_GROUPS=

# Entry frequency / risk brakes
# Cooldown (minutes) per symbol after a stop-loss close
POST_SL_COOLDOWN_MIN=60
# Max executed setups per symbol per day (UTC)
MAX_SETUPS_PER_SYMBOL_PER_DAY=3
# Bot-wide daily loss limit (fraction of day-start balance)
DAILY_MAX_LOSS_PCT=0.03

# Sizing guards
# Maximum nominal Stop Loss risk per complete setup. Values above 1% are
# hard-clamped to 1%; split TP legs share this one aggregate budget.
MT5_RISK_PCT=0.01
# Fixed starting-capital risk base. Leave 0 to capture the account balance once
# into ai_data/risk_capital.json; set an explicit amount to override that file.
MT5_INITIAL_CAPITAL=0
# Cap on total lots per setup
MT5_MAX_VOLUME=10.0
# Round-turn commission per 1.0 lot in the account currency, included in sizing
MT5_COMMISSION_PER_LOT=7.0

# Optional staged entries into one idea. All split legs and all simultaneously
# risking entries share one fixed-starting-capital budget. Values above 1% are
# hard-clamped to 1%; add-ons reuse budget released by moving prior entries to BE.
POSITION_ADDING_ENABLED=0
IDEA_MAX_ENTRIES=3
IDEA_MAX_RISK_PCT=0.01
ADDON_MIN_PROGRESS_R=0.5
ADDON_MAX_PROGRESS_PCT=0.5

# Vol-regime filter (IV Surface 7-signal score, computed from daily candles)
VOL_REGIME_FILTER=1
VOL_REGIME_SYMBOLS=GOLD,EURUSD,GBPUSD,USDCAD
# Block entries while R(t) >= this score (PANIC); 0 disables the score gate
VOL_REGIME_MAX_R=60
# Block setups whose TP1 is further than N x the 1-day expected move; 0 disables
EM_TP_MAX_RATIO=1.0
# Recompute the vol context at most every N minutes per symbol
VOL_REGIME_REFRESH_MIN=15
