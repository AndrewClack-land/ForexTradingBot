# Install as /etc/forexbot-orca/orca-prediction.env with mode 0600.
# Linux-side research scorer only. It never loads MT5 or executes orders.
# The panel index must be actual availability times of fully closed D1 bars.
ORCA_PRICES_PATH=/srv/forexbot-backtest/orca/prices.parquet
ORCA_BENCHMARK_SYMBOL=SPY

# Promotion is manual. The file may be a direct orca-random-forest-v1 artifact
# or an orca-feature-rf-research-pipeline-v1 containing model_artifact.
# Keep this path outside ReadWritePaths so ProtectSystem=strict makes it read-only.
ORCA_PROMOTED_ARTIFACT_PATH=/opt/forexbot-orca/models/orca-rf.json

# Both SHA-256 pins are mandatory. Copy them only from an approved WFO report;
# the publisher never trains, selects, rewrites, or promotes a challenger.
ORCA_PROMOTED_ARTIFACT_HASH=replace_with_64_lowercase_hex_characters
ORCA_PROMOTED_FEATURE_REGISTRY_HASH=replace_with_64_lowercase_hex_characters
ORCA_PROMOTED_FOLD_INDEX=-1
ORCA_PROMOTED_MODEL_ID=orca-regime-v1-champion

# Atomic output consumed by monitoring.orca_monitor.JsonPredictionProvider.
ORCA_PREDICTION_PATH=/var/lib/forexbot-orca/prediction.json
ORCA_PREDICTION_STALE_AFTER_SECONDS=129600
