# Install as /etc/forexbot-orca/orca-eodhd.env with mode 0600.
EODHD_API_TOKEN=replace-with-secret-token
ORCA_EODHD_OUTPUT_PATH=/srv/forexbot-backtest/orca/prices.parquet
ORCA_EODHD_START_DATE=2015-01-01
ORCA_EODHD_MIN_ALIGNED_ROWS=372
ORCA_EODHD_FFILL_LIMIT=5
ORCA_EODHD_AVAILABILITY_HOUR_UTC=12
ORCA_EODHD_TIMEOUT_SECONDS=30
