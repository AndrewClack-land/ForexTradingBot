# Non-secret parameters for /etc/forexbot/lse-import.env.
# The API key belongs only in the root-only /etc/forexbot/lse.env.
#
# LSE_OUTPUT_DIR is a new target in the writable incoming area. Choose a NEW
# path for every run: the importer fails when it already exists. After a
# successful run, an administrator moves it into the root-owned snapshot
# archive and removes write access as documented in README.md.
LSE_OUTPUT_DIR=/var/lib/forexbot-backtest/incoming/fx-2020-2026-v1
LSE_SYMBOLS="EURUSD GBPUSD USDCAD"
LSE_START=2020-01-01
LSE_END=2026-07-24
# Paged REST is the safe default for a long, multi-symbol range. Export jobs
# are hourly quota-limited; use export only for a deliberately short run.
LSE_TRANSPORT=rest
# Leave empty to resolve and validate each symbol's dataset from the LSE
# catalog (for example fx versus commodity).
LSE_DATASET=
LSE_BAR_TIMEZONE=Europe/Athens
LSE_TIMEFRAMES="1m 5m 15m 1h 4h 1d"
# About 171 requests/minute, below the observed 200/minute account limit.
LSE_REST_MIN_INTERVAL=0.35
# Fail closed on truncated edges/large internal holes, and drop derived bars
# missing more than 5% of their expected M1 source rows.
LSE_MIN_BUCKET_COVERAGE=0.95
LSE_MAX_EDGE_GAP_DAYS=4
LSE_MAX_INTERNAL_GAP_DAYS=4
