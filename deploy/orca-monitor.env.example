# Install as /etc/forexbot-orca/orca-monitor.env with mode 0600.
# Separate Linux-side ORCA process. Never load this file in the MT5/Wine bot.
ORCA_PRICES_PATH=/srv/forexbot-backtest/orca/prices.parquet
ORCA_SNAPSHOT_PATH=/var/lib/forexbot-orca/latest.json
# Optional immutable output of the separately validated model scorer.
ORCA_PREDICTION_PATH=/var/lib/forexbot-orca/prediction.json
ORCA_MONITOR_HOST=127.0.0.1
ORCA_MONITOR_PORT=8765
ORCA_REFRESH_SECONDS=300
ORCA_STALE_AFTER_SECONDS=129600
ORCA_EXPECTED_ASSETS=24
# Optional exact-universe contract. Blank keeps the count-only behaviour above.
# Set to orca-fx-gold-4-v1 when ORCA_PRICES_PATH is the sealed LSE ORCA-4
# panel: it pins the symbols, the asset count and the absorption ranks
# together, so a four-asset panel can never be scored with the 24-asset
# spectral contract. Leave ORCA_EXPECTED_ASSETS unset when a profile is used.
ORCA_UNIVERSE_PROFILE=
# Alternative to a profile: an explicit comma/space-separated symbol order that
# must match ORCA_EXPECTED_ASSETS.
ORCA_EXPECTED_SYMBOLS=
