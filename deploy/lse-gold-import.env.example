# Non-secret parameters for the isolated GOLD-only LSE import.
# The API key stays only in the root-owned /etc/forexbot/lse.env.
#
# Keep this target distinct from the existing three-symbol FX snapshot. The
# importer publishes atomically and refuses to replace an existing target.
LSE_OUTPUT_DIR=/var/lib/forexbot-backtest/incoming/gold-2020-2026-lse-v1
LSE_SYMBOLS="GOLD=XAU/USD"
# Match the sealed FX snapshot exactly so their D1 series can be aligned
# without downloading EURUSD, GBPUSD or USDCAD again.
LSE_START=2020-01-01
LSE_END=2026-07-24
# One symbol over this interval requires four 600-day export jobs, below the
# importer's fail-closed maximum of five jobs per invocation.
LSE_TRANSPORT=export
# XAU/USD is catalogued by London Strategic Edge as a commodity.
LSE_DATASET=commodity
LSE_BAR_TIMEZONE=Europe/Athens
# ORCA needs D1. The importer always retains its canonical M1 source as well,
# so this produces GOLD_1m.parquet and GOLD_1d.parquet only.
LSE_TIMEFRAMES="1d"
LSE_REST_MIN_INTERVAL=0.35
LSE_MIN_BUCKET_COVERAGE=0.95
LSE_MAX_EDGE_GAP_DAYS=4
LSE_MAX_INTERNAL_GAP_DAYS=4
