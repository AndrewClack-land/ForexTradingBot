[Unit]
Description=Publish causal EODHD panel for ORCA
Documentation=https://eodhd.com/financial-apis/api-for-historical-data-and-volumes/
After=network-online.target
Wants=network-online.target
OnSuccess=orca-prediction.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/forexbot
EnvironmentFile=/etc/forexbot-orca/orca-eodhd.env
ExecStart=/opt/forexbot-orca/venv/bin/python -m monitoring.orca_eodhd_ingest
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/forexbot-backtest/orca
